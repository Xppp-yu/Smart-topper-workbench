{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-topper.local/schemas/slp_canonical_sample_v0.1.schema.json",
  "title": "SLP Canonical Sample v0.1",
  "description": "Per-frame canonical SLP sample with Frame/Joint/Region layers and A04 geometry contract. Generated by the A05 adapter; never modified by downstream tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "setting",
    "subject_id",
    "cover_condition",
    "frame_index",
    "coordinate_frame",
    "coordinate_origin_status",
    "frame",
    "joint",
    "region",
    "provenance",
    "quality_flags",
    "quarantine",
    "quarantine_reasons"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^slp::"},
    "setting": {"enum": ["danaLab", "simLab"]},
    "subject_id": {"type": "string", "pattern": "^[0-9]{5}$"},
    "cover_condition": {"enum": ["uncover", "cover1", "cover2"]},
    "frame_index": {"type": "integer", "minimum": 1, "maximum": 45},
    "coordinate_frame": {"const": "raw_dataset_pixel_coordinates_no_offset"},
    "coordinate_origin_status": {
      "const": "UNRESOLVED_RAW_DATASET_COORDINATES_NO_OFFSET_APPLIED"
    },
    "frame": {"$ref": "#/$defs/frame_layer"},
    "joint": {"$ref": "#/$defs/joint_layer"},
    "region": {"$ref": "#/$defs/region_layer"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "quality_flags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "quarantine": {"type": "boolean"},
    "quarantine_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "description": "A05 must never carry region training truth.",
      "if": {"properties": {"region": {"required": ["can_be_used_as_training_truth"]}}},
      "then": {
        "properties": {
          "region": {"properties": {"can_be_used_as_training_truth": {"const": false}}}
        }
      }
    },
    {
      "description": "A05 must never write split, review, or model predictions back to the sample.",
      "properties": {
        "provenance": {
          "properties": {
            "subject_split_applied": {"const": false},
            "review_status_applied": {"const": false},
            "model_prediction_applied": {"const": false},
            "semantic_direction_auto_selected": {"const": false},
            "coordinate_origin_auto_shifted": {"const": false},
            "silent_imputation": {"const": false}
          }
        }
      }
    }
  ],
  "$defs": {
    "frame_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "setting",
        "subject_id",
        "cover_condition",
        "frame_index",
        "modality_uris",
        "missing_modalities",
        "expected_missing_modalities",
        "ambiguous_modalities",
        "uri_existence_flags"
      ],
      "properties": {
        "sample_id": {"type": "string"},
        "setting": {"enum": ["danaLab", "simLab"]},
        "subject_id": {"type": "string"},
        "cover_condition": {"enum": ["uncover", "cover1", "cover2"]},
        "frame_index": {"type": "integer", "minimum": 1, "maximum": 45},
        "modality_uris": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "required": ["RGB", "IR", "IRraw", "depth", "depthRaw", "PM"]
        },
        "missing_modalities": {
          "type": "array",
          "items": {
            "enum": ["RGB", "IR", "IRraw", "depth", "depthRaw", "PM"]
          },
          "uniqueItems": true
        },
        "expected_missing_modalities": {
          "type": "array",
          "items": {
            "enum": ["RGB", "IR", "IRraw", "depth", "depthRaw", "PM"]
          },
          "uniqueItems": true
        },
        "ambiguous_modalities": {
          "type": "array",
          "items": {
            "enum": ["RGB", "IR", "IRraw", "depth", "depthRaw", "PM"]
          },
          "uniqueItems": true
        },
        "uri_existence_flags": {
          "type": "object",
          "additionalProperties": {
            "enum": ["present", "absent", "missing_on_disk"]
          },
          "required": ["RGB", "IR", "IRraw", "depth", "depthRaw", "PM"]
        }
      }
    },
    "joint_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "j0_source_uris",
        "j0_present",
        "j0_artifact_count",
        "joint_provenance_status",
        "j1_status",
        "homography_contracts"
      ],
      "properties": {
        "j0_source_uris": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "required": ["RGB", "IR"]
        },
        "j0_present": {
          "type": "object",
          "additionalProperties": {"type": "boolean"},
          "required": ["RGB", "IR"]
        },
        "j0_artifact_count": {"const": 14},
        "joint_provenance_status": {"const": "j0_only_j1_pending_a04_direction_resolution"},
        "j1_status": {
          "const": "not_generated_A04_direction_unresolved_see_homography_contract"
        },
        "homography_contracts": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/homography_contract"},
          "required": ["RGB", "IR", "depth"]
        }
      }
    },
    "homography_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modality",
        "matrix_uri",
        "matrix_present",
        "invertible",
        "direction_status",
        "coordinate_origin_status",
        "probe_roundtrip_mean_error",
        "probe_roundtrip_max_error",
        "direct_joint_in_bounds_rate",
        "inverse_joint_in_bounds_rate",
        "error_codes",
        "blocked",
        "unresolved_direction"
      ],
      "properties": {
        "modality": {"enum": ["RGB", "IR", "depth"]},
        "matrix_uri": {"type": "string"},
        "matrix_present": {"type": "boolean"},
        "invertible": {"type": "boolean"},
        "direction_status": {
          "type": "string",
          "pattern": "^(BLOCKED_|UNRESOLVED_).+"
        },
        "coordinate_origin_status": {
          "const": "UNRESOLVED_RAW_DATASET_COORDINATES_NO_OFFSET_APPLIED"
        },
        "probe_roundtrip_mean_error": {"type": ["number", "null"]},
        "probe_roundtrip_max_error": {"type": ["number", "null"]},
        "direct_joint_in_bounds_rate": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
        "inverse_joint_in_bounds_rate": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
        "error_codes": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "blocked": {"type": "boolean"},
        "unresolved_direction": {"type": "boolean"}
      }
    },
    "region_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "placeholder_status",
        "annotation_count",
        "annotations",
        "can_be_used_as_training_truth"
      ],
      "properties": {
        "schema_version": {"const": "slp_region_annotation_v0.1"},
        "placeholder_status": {
          "const": "A10_to_A17_pending_no_training_truth_generated_by_a05"
        },
        "annotation_count": {"const": 0},
        "annotations": {
          "type": "array",
          "maxItems": 0
        },
        "can_be_used_as_training_truth": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "adapter_version",
        "canonical_schema_version",
        "generator",
        "created_at",
        "a03_frame_index_source",
        "a04_homography_audit_source",
        "slp_root",
        "pairing_method",
        "semantic_direction_auto_selected",
        "coordinate_origin_auto_shifted",
        "silent_imputation",
        "subject_split_applied",
        "review_status_applied",
        "model_prediction_applied"
      ],
      "properties": {
        "task_id": {"const": "TASK-SLP-A05-CANONICAL-ADAPTER-v0.1"},
        "adapter_version": {"const": "slp_canonical_adapter_v0.1"},
        "canonical_schema_version": {"const": "slp_canonical_sample_v0.1"},
        "generator": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "a03_frame_index_source": {"type": "string", "minLength": 1},
        "a04_homography_audit_source": {"type": "string"},
        "slp_root": {"type": "string"},
        "pairing_method": {"const": "explicit_frame_index_join_via_a03"},
        "semantic_direction_auto_selected": {"const": false},
        "coordinate_origin_auto_shifted": {"const": false},
        "silent_imputation": {"const": false},
        "subject_split_applied": {"const": false},
        "review_status_applied": {"const": false},
        "model_prediction_applied": {"const": false}
      }
    }
  }
}
