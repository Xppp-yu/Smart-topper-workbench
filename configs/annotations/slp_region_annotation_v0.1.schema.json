{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-topper.local/schemas/slp_region_annotation_v0.1.schema.json",
  "title": "SLP Region Annotation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "sample_id",
    "setting",
    "subject_id",
    "cover_condition",
    "frame_index",
    "coordinate_frame",
    "region_id",
    "label_tier",
    "label_source",
    "joint_gt_source",
    "review_status",
    "proposal_polygon",
    "final_polygon",
    "algorithm_version",
    "parameter_hash",
    "homography_sha256",
    "alignment_confidence",
    "anatomical_confidence",
    "quality_flags",
    "reviewer_id",
    "reviewed_at",
    "reason_codes",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "slp_region_annotation_v0.1"},
    "annotation_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "pattern": "^slp::"},
    "setting": {"enum": ["danaLab", "simLab"]},
    "subject_id": {"type": "string", "pattern": "^[0-9]{5}$"},
    "cover_condition": {"enum": ["uncover", "cover1", "cover2"]},
    "frame_index": {"type": "integer", "minimum": 1, "maximum": 45},
    "coordinate_frame": {"enum": ["rgb", "ir", "depth", "pm"]},
    "region_id": {
      "enum": [
        "head_neck",
        "shoulder_left",
        "shoulder_right",
        "thorax_back",
        "abdomen_waist",
        "pelvis_hip",
        "thigh_left",
        "thigh_right",
        "lower_leg_foot_left",
        "lower_leg_foot_right"
      ]
    },
    "label_tier": {"enum": ["R0", "R1", "R2", "R3"]},
    "label_source": {
      "enum": [
        "joint_geometry",
        "opencv_refined",
        "human_accepted",
        "human_edited",
        "human_consensus"
      ]
    },
    "joint_gt_source": {"enum": ["manual_rgb", "manual_ir", "homography_derived"]},
    "review_status": {
      "enum": ["pending", "accepted", "edited", "rejected", "uncertain", "adjudicated"]
    },
    "proposal_polygon": {"$ref": "#/$defs/polygon"},
    "final_polygon": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/polygon"}
      ]
    },
    "algorithm_version": {"type": "string", "minLength": 1},
    "parameter_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "homography_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      ]
    },
    "alignment_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "anatomical_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "quality_flags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reviewer_id": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "alignment",
          "joint_error",
          "occlusion",
          "blanket_contour",
          "region_ambiguity",
          "polygon_topology",
          "low_image_quality",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifacts", "generator", "created_at"],
      "properties": {
        "source_artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "generator": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"label_tier": {"enum": ["R2", "R3"]}}},
      "then": {
        "properties": {
          "review_status": {"enum": ["accepted", "edited", "adjudicated"]},
          "final_polygon": {"$ref": "#/$defs/polygon"},
          "reviewer_id": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "items": {"$ref": "#/$defs/point"},
      "minItems": 3
    }
  }
}
